# Copiar a .env (nunca commitear). Backend.
# --- Supabase (ADR-0001) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase   # verificación del JWT en Fastify (ADR-0006)

# --- Amazon S3, evidencias (ADR-0007) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_EVIDENCIAS=dunamis-evidencias

# --- Servidor ---
PORT=3000

# Frontend (prefijo VITE_ para exponerlas al cliente)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
