# Copiar a .env (nunca commitear). Backend.
# --- Supabase (ADR-0001) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres   # Settings → Database → Connection string (URI)
SUPABASE_URL=https://tu-proyecto.supabase.co                          # Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key                         # Settings → API → service_role (SOLO backend, secreta)
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase                         # verificación del JWT en Fastify (ADR-0006)

# --- Supabase Storage, evidencias (ADR-0009) ---
SUPABASE_BUCKET_EVIDENCIAS=evidencias

# --- Servidor ---
PORT=3000

# Frontend (prefijo VITE_ para exponerlas al cliente)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
